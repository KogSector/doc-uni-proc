{
  "version": 2,
  "functions": {
    "api/index/src/main.rs": {
      "runtime": "vercel-rust@4.0.9"
    },
    "api/process/src/main.rs": {
      "runtime": "vercel-rust@4.0.9"
    },
    "api/batch/src/main.rs": {
      "runtime": "vercel-rust@4.0.9"
    },
    "api/sync/src/main.rs": {
      "runtime": "vercel-rust@4.0.9"
    },
    "api/status/src/main.rs": {
      "runtime": "vercel-rust@4.0.9"
    },
    "api/local/src/main.rs": {
      "runtime": "vercel-rust@4.0.9"
    }
  },
  "routes": [
    {
      "src": "/health",
      "dest": "/api/index"
    },
    {
      "src": "/",
      "dest": "/api/index"
    },
    {
      "src": "/api/v1/documents/process",
      "dest": "/api/process"
    },
    {
      "src": "/api/v1/process",
      "dest": "/api/process"
    },
    {
      "src": "/api/v1/documents/batch",
      "dest": "/api/batch"
    },
    {
      "src": "/api/v1/graph/sync",
      "dest": "/api/sync"
    },
    {
      "src": "/api/v1/status/(.*)",
      "dest": "/api/status"
    },
    {
      "src": "/api/v1/process/local",
      "dest": "/api/local"
    }
  ]
}
